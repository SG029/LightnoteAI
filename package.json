{
  "name": "lightedit",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered video object replacement — natural-language editing over a MERN + Python pipeline",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web,ml -c cyan,magenta,yellow \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:ml\"",
    "dev:api": "npm --prefix server run dev",
    "dev:web": "npm --prefix client run dev",
    "dev:ml": "node scripts/dev-ml.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "setup": "node scripts/setup.mjs",
    "sample": "node scripts/dev-ml.mjs --sample",
    "mongo:up": "docker compose up -d",
    "mongo:down": "docker compose down",
    "doctor": "node scripts/doctor.mjs",
    "build": "npm --prefix client run build && npm --prefix server run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
