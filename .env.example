# ─────────────────────────────────────────────────────────────
# LightEdit — copy this file to `.env` and fill in the blanks.
#   cp .env.example .env      (PowerShell: copy .env.example .env)
# ─────────────────────────────────────────────────────────────

# ── Gemini ───────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Parses the natural-language instruction and grounds the target
# object in the keyframe. gemini-2.5-flash also works if you hit
# quota limits, but brand-level grounding ("Coca-Cola bottle")
# is noticeably weaker on it.
GEMINI_TEXT_MODEL=gemini-3.5-flash

# Generates / edits the replacement asset. This MUST be an image
# model — the text model above cannot produce pixels.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── Datastore ────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/lightedit

# ── Services ─────────────────────────────────────────────────
PORT=4000
ML_SERVICE_URL=http://localhost:8000

# Shared secret the Python worker uses to post progress back to
# Express. Any random string; it never leaves your machine.
INTERNAL_SECRET=change-me-to-anything

# ── Processing limits ────────────────────────────────────────
# Longer or larger inputs are rejected with a 400 rather than
# silently taking twenty minutes. See README "Known limitations".
MAX_VIDEO_MB=100
MAX_DURATION_SEC=15
TARGET_HEIGHT=720

# Set to 1 to run the ML pipeline on CPU. Works, but expect
# several minutes per clip instead of seconds.
FORCE_CPU=0

# ── Client ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
