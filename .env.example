# ─────────────────────────────────────────────────────────────
# LightEdit — copy this file to `.env` and fill in the blanks.
#   cp .env.example .env      (PowerShell: copy .env.example .env)
# ─────────────────────────────────────────────────────────────

# ── Gemini ───────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Parses the natural-language instruction and grounds the target
# object in the keyframe. gemini-2.5-flash also works if you hit
# quota limits, but brand-level grounding ("Coca-Cola bottle")
# is noticeably weaker on it.
GEMINI_TEXT_MODEL=gemini-3.5-flash

# Generates the replacement asset. This MUST be an image model — the
# text model above cannot produce pixels.
#
# Use the 2.5 variant: it is included on the free tier (~500 requests/day).
# The newer gemini-3.1-flash-image is paid-only and returns a 429 with
# "limit: 0" on a free key, which the pipeline treats as "unavailable" and
# degrades to the reference-image path.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── Datastore ────────────────────────────────────────────────
# 127.0.0.1 rather than "localhost": on Windows, localhost resolves to the
# IPv6 ::1 first, and mongod binds IPv4 only by default — which surfaces as
# a confusing "connect ECONNREFUSED ::1:27017".
MONGODB_URI=mongodb://127.0.0.1:27017/lightedit

# ── Services ─────────────────────────────────────────────────
PORT=4000
ML_SERVICE_URL=http://localhost:8000

# Shared secret the Python worker uses to post progress back to
# Express. Any random string; it never leaves your machine.
INTERNAL_SECRET=change-me-to-anything

# ── Processing limits ────────────────────────────────────────
# Longer or larger inputs are rejected with a 400 rather than
# silently taking twenty minutes. See README "Known limitations".
MAX_VIDEO_MB=100
MAX_DURATION_SEC=15
TARGET_HEIGHT=720

# Set to 1 to run the ML pipeline on CPU. Works, but expect
# several minutes per clip instead of seconds.
FORCE_CPU=0

# ── Client ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
